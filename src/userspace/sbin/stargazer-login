#!/bin/sh
# Stargazer NGFW - Login Handler
# Ensures Linux admin user exists, then runs login loop via stargazer-logind.
# Database seeding is handled by mgmtd on first boot — this script only
# maintains the Linux user account (passwd/shadow/group).

CMD_DIR="/usr/libexec/stargazer"
. "$CMD_DIR/config_lib.sh"

# ----------------------------------------------------------------------------
# Ensure built-in admin account exists in Linux user database
# Only manages passwd/shadow/group — config lives in mgmtd's SQLite DB
# ----------------------------------------------------------------------------
ensure_admin_account() {
	mkdir -p "$STARGAZER_CONF_DIR"
	chmod 750 "$STARGAZER_CONF_DIR" 2>/dev/null

	# ── Instance ID (unique per install) ──────────────────────────────────
	if [ ! -f "$STARGAZER_CONF_DIR/.instance-id" ]; then
		cat /proc/sys/kernel/random/uuid \
			> "$STARGAZER_CONF_DIR/.instance-id" 2>/dev/null \
			|| echo "no-uuid" > "$STARGAZER_CONF_DIR/.instance-id"
	fi

	# Find next available UID >= 1000 for admin
	_ea_next_uid=1000
	if [ -f /etc/passwd ]; then
		while grep -q "^[^:]*:[^:]*:${_ea_next_uid}:" /etc/passwd 2>/dev/null; do
			_ea_next_uid=$((_ea_next_uid + 1))
		done
	fi

	if grep -q '^admin:' /etc/passwd 2>/dev/null; then
		# Admin exists — ensure shell is correct, but preserve existing UID
		_ea_cur_uid=$(grep '^admin:' /etc/passwd | head -1 | cut -d: -f3)
		if [ "$_ea_cur_uid" = "0" ]; then
			# Migrate UID 0 admin to unprivileged UID (VULN-06)
			_ea_tmp=$(mktemp /etc/passwd.XXXXXX 2>/dev/null) || _ea_tmp="/etc/passwd.tmp.$$"
			sed "s|^admin:[^:]*:[0-9]*:[0-9]*:[^:]*:[^:]*:.*|admin:x:${_ea_next_uid}:${_ea_next_uid}:Stargazer Admin:/home/admin:/sbin/stargazer-cli|" /etc/passwd > "$_ea_tmp" && mv "$_ea_tmp" /etc/passwd
			if ! grep -q "^admin:" /etc/group 2>/dev/null; then
				echo "admin:x:${_ea_next_uid}:" >> /etc/group
			fi
			mkdir -p /home/admin 2>/dev/null
			chown "${_ea_next_uid}:${_ea_next_uid}" /home/admin 2>/dev/null
		else
			# Non-root UID — just fix shell
			_ea_tmp=$(mktemp /etc/passwd.XXXXXX 2>/dev/null) || _ea_tmp="/etc/passwd.tmp.$$"
			sed "s|^admin:\([^:]*\):\([0-9]*\):\([0-9]*\):[^:]*:[^:]*:.*|admin:\1:\2:\3:Stargazer Admin:/home/admin:/sbin/stargazer-cli|" /etc/passwd > "$_ea_tmp" && mv "$_ea_tmp" /etc/passwd
		fi
	else
		echo "admin:x:${_ea_next_uid}:${_ea_next_uid}:Stargazer Admin:/home/admin:/sbin/stargazer-cli" >> /etc/passwd
		if ! grep -q "^admin:" /etc/group 2>/dev/null; then
			echo "admin:x:${_ea_next_uid}:" >> /etc/group
		fi
		mkdir -p /home/admin 2>/dev/null
		chown "${_ea_next_uid}:${_ea_next_uid}" /home/admin 2>/dev/null
	fi

	# Only create shadow entry if missing — never reset existing password
	if ! grep -q '^admin:' /etc/shadow 2>/dev/null; then
		echo 'admin::19700:0:99999:7:::' >> /etc/shadow
	fi

	# Add admin to stargazer group (for socket + config access)
	if grep -q '^stargazer:' /etc/group 2>/dev/null; then
		if ! grep '^stargazer:' /etc/group | grep -q '\badmin\b' 2>/dev/null; then
			_ea_grp_line=$(grep '^stargazer:' /etc/group)
			_ea_members="${_ea_grp_line##*:}"
			if [ -n "$_ea_members" ]; then
				_ea_new="${_ea_grp_line},admin"
			else
				_ea_new="${_ea_grp_line}admin"
			fi
			_ea_tmp=$(mktemp /etc/group.XXXXXX 2>/dev/null) || _ea_tmp="/etc/group.tmp.$$"
			sed "s|^stargazer:.*|${_ea_new}|" /etc/group > "$_ea_tmp" && mv "$_ea_tmp" /etc/group
		fi
	fi

	# Set DB file permissions: root:stargazer 0660
	_sg_grp="stargazer"
	if [ -f "$STARGAZER_DB_PATH" ]; then
		chmod 660 "$STARGAZER_DB_PATH" 2>/dev/null
		chgrp "$_sg_grp" "$STARGAZER_DB_PATH" 2>/dev/null
	fi
	chgrp "$_sg_grp" "$STARGAZER_CONF_DIR" 2>/dev/null
	chmod 750 "$STARGAZER_CONF_DIR" 2>/dev/null
}

# ----------------------------------------------------------------------------
# Main: ensure admin exists on every boot
# ----------------------------------------------------------------------------
ensure_admin_account

# ----------------------------------------------------------------------------
# Phase B auth hardening: username pre-check + lockout/backoff + audit
# ----------------------------------------------------------------------------

AUTH_STATE_FILE="/tmp/stargazer-auth.state"
AUTH_MAX_FAILS=5
AUTH_LOCK_BASE=120
AUTH_LOCK_MAX=3600

auth_get_state() {
	_ag_user="$1"
	_ag_count=0
	_ag_until=0
	if _db_ready; then
		_ag_uq=$(_db_escape "$_ag_user")
		_ag_row=$(sqlite3 "$STARGAZER_DB_PATH" "SELECT fail_count, locked_until FROM auth_lockouts WHERE username='${_ag_uq}' LIMIT 1;" 2>/dev/null)
		if [ -n "$_ag_row" ]; then
			_ag_count="${_ag_row%%|*}"
			_ag_until="${_ag_row#*|}"
		fi
		echo "${_ag_count:-0}:${_ag_until:-0}"
		return
	fi
	[ -f "$AUTH_STATE_FILE" ] || {
		echo "$_ag_count:$_ag_until"
		return
	}
	while IFS=: read -r _u _c _t || [ -n "$_u" ]; do
		[ "$_u" = "$_ag_user" ] || continue
		_ag_count="${_c:-0}"
		_ag_until="${_t:-0}"
		break
	done < "$AUTH_STATE_FILE"
	echo "$_ag_count:$_ag_until"
}

auth_set_state() {
	_as_user="$1"
	_as_count="$2"
	_as_until="$3"
	if _db_ready; then
		_as_uq=$(_db_escape "$_as_user")
		sqlite3 "$STARGAZER_DB_PATH" "INSERT INTO auth_lockouts(username, fail_count, locked_until, updated_at)
		VALUES('${_as_uq}', ${_as_count}, ${_as_until}, datetime('now'))
		ON CONFLICT(username) DO UPDATE SET
		fail_count=excluded.fail_count,
		locked_until=excluded.locked_until,
		updated_at=datetime('now');" >/dev/null 2>&1 || true
		return
	fi
	_as_tmp="${AUTH_STATE_FILE}.tmp.$$"
	> "$_as_tmp"
	if [ -f "$AUTH_STATE_FILE" ]; then
		while IFS=: read -r _u _c _t || [ -n "$_u" ]; do
			[ -z "$_u" ] && continue
			[ "$_u" = "$_as_user" ] && continue
			echo "${_u}:${_c}:${_t}" >> "$_as_tmp"
		done < "$AUTH_STATE_FILE"
	fi
	echo "${_as_user}:${_as_count}:${_as_until}" >> "$_as_tmp"
	mv "$_as_tmp" "$AUTH_STATE_FILE"
}

auth_clear_state() {
	_ac_user="$1"
	if _db_ready; then
		_ac_uq=$(_db_escape "$_ac_user")
		sqlite3 "$STARGAZER_DB_PATH" "DELETE FROM auth_lockouts WHERE username='${_ac_uq}';" >/dev/null 2>&1 || true
		return 0
	fi
	_ac_tmp="${AUTH_STATE_FILE}.tmp.$$"
	[ -f "$AUTH_STATE_FILE" ] || return 0
	> "$_ac_tmp"
	while IFS=: read -r _u _c _t || [ -n "$_u" ]; do
		[ -z "$_u" ] && continue
		[ "$_u" = "$_ac_user" ] && continue
		echo "${_u}:${_c}:${_t}" >> "$_ac_tmp"
	done < "$AUTH_STATE_FILE"
	mv "$_ac_tmp" "$AUTH_STATE_FILE"
}

auth_note_fail() {
	_af_user="$1"
	_af_now=$(date +%s 2>/dev/null || echo 0)
	_af_state=$(auth_get_state "$_af_user")
	_af_count=${_af_state%%:*}
	_af_until=${_af_state#*:}
	[ "$_af_now" -ge "${_af_until:-0}" ] && _af_count=0
	_af_count=$((_af_count + 1))
	if [ "$_af_count" -ge "$AUTH_MAX_FAILS" ]; then
		# Escalating lockout: 2min → 4min → 8min ... max 1hr (BUG-AUTH-07)
		_af_rounds=$(( (_af_count - AUTH_MAX_FAILS) / AUTH_MAX_FAILS ))
		_af_duration=$AUTH_LOCK_BASE
		_af_i=0
		while [ "$_af_i" -lt "$_af_rounds" ] && [ "$_af_duration" -lt "$AUTH_LOCK_MAX" ]; do
			_af_duration=$((_af_duration * 2))
			_af_i=$((_af_i + 1))
		done
		[ "$_af_duration" -gt "$AUTH_LOCK_MAX" ] && _af_duration=$AUTH_LOCK_MAX
		_af_until=$((_af_now + _af_duration))
	else
		_af_until=0
	fi
	auth_set_state "$_af_user" "$_af_count" "$_af_until"
}

auth_is_locked() {
	_al_user="$1"
	_al_now=$(date +%s 2>/dev/null || echo 0)
	_al_state=$(auth_get_state "$_al_user")
	_al_until=${_al_state#*:}
	[ "$_al_now" -lt "${_al_until:-0}" ]
}

admin_exists_in_config() {
	_ae_user="$1"
	# Check the normalized config table (mgmtd's SQLite DB)
	if _db_ready; then
		_ae_uq=$(_db_escape "$_ae_user")
		_ae_exists=$(sqlite3 "$STARGAZER_DB_PATH" \
			"SELECT 1 FROM config WHERE type='system_admin' AND id='${_ae_uq}' LIMIT 1;" 2>/dev/null)
		[ "$_ae_exists" = "1" ] && return 0
		return 1
	fi
	# Fallback: check if user exists in passwd with stargazer-cli shell
	grep "^${_ae_user}:" /etc/passwd 2>/dev/null | grep -q '/sbin/stargazer-cli'
}

# ── Ctrl+C resets to fresh login prompt (no process restart) ──
_login_interrupted=0
trap '_login_interrupted=1' INT

while true; do
	# ── Clean ALL login context at start of each iteration ──
	_login_interrupted=0
	unset STARGAZER_LOGIN_USER
	unset STARGAZER_USER
	unset LOGIN
	_login_user=""

	printf "login: "
	read -r _login_user
	_read_rc=$?

	# ── Handle Ctrl+C: reset to fresh login prompt ──
	if [ "$_login_interrupted" -eq 1 ]; then
		echo ""
		continue
	fi

	# ── Handle EOF (Ctrl+D) or read failure: restart prompt ──
	if [ "$_read_rc" -ne 0 ]; then
		echo ""
		continue
	fi

	# ── Normalize username to lowercase (BUG-AUTH-04: prevent lockout bypass) ──
	_login_user=$(printf '%s' "$_login_user" | tr 'A-Z' 'a-z')

	# ── Set login context for this attempt only ──
	export STARGAZER_USER="$_login_user"
	export STARGAZER_LOGIN_USER="$_login_user"
	export LOGIN="$_login_user"
	auth_debug "login_attempt attempt_user=${_login_user} env_STARGAZER_LOGIN_USER=${STARGAZER_LOGIN_USER} env_LOGIN=${LOGIN}"

	# ── Check lockout BEFORE authentication (BUG-AUTH-08) ──
	if _is_safe_id "$_login_user" \
		&& admin_exists_in_config "$_login_user" \
		&& grep -q "^${_login_user}:" /etc/passwd 2>/dev/null; then
		if auth_is_locked "$_login_user"; then
			audit_log "login_reject" "user=${_login_user} reason=locked"
			echo "Account temporarily locked. Try again later."
			sleep 1
			# ── Ctrl+C during lockout wait → reset ──
			if [ "$_login_interrupted" -eq 1 ]; then echo ""; continue; fi
			# Cleanup context
			unset STARGAZER_LOGIN_USER
			unset STARGAZER_USER
			unset LOGIN
			continue
		fi
	fi

	/sbin/stargazer-logind "$_login_user"
	_logind_rc=$?

	# ── Ctrl+C during password/change-password → reset to login prompt ──
	if [ "$_logind_rc" -eq 130 ] || [ "$_login_interrupted" -eq 1 ]; then
		echo ""
		unset STARGAZER_LOGIN_USER STARGAZER_USER LOGIN
		continue
	fi

	if [ "$_logind_rc" -eq 0 ]; then
		auth_clear_state "$_login_user"
		audit_log "login_success" "user=${_login_user}"
		# Cleanup before exit
		unset STARGAZER_LOGIN_USER
		unset STARGAZER_USER
		unset LOGIN
		exit 0
	fi

	# ── Cleanup ALL login context after failed attempt ──
	unset STARGAZER_LOGIN_USER
	unset STARGAZER_USER
	unset LOGIN

	# Apply lockout accounting only for syntactically-safe existing users
	if _is_safe_id "$_login_user" \
		&& admin_exists_in_config "$_login_user" \
		&& grep -q "^${_login_user}:" /etc/passwd 2>/dev/null; then
		auth_note_fail "$_login_user"
		audit_log "login_reject" "user=${_login_user} reason=bad-password"
	else
		audit_log "login_reject" "user=${_login_user} reason=invalid-credential"
	fi
	sleep 1
	# ── Ctrl+C during failure delay → reset ──
	if [ "$_login_interrupted" -eq 1 ]; then echo ""; continue; fi
done

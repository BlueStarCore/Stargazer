#!/bin/sh
# Stargazer NGFW - Init (PID 1)

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# Mount filesystems
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || true
mount -t tmpfs -o mode=1777 none /tmp 2>/dev/null || true
mkdir -p /run 2>/dev/null
# devtmpfs mounted from userspace gets a fresh superblock separate from
# the kernel's internal instance — nodes may be absent.
[ -c /dev/null ]    || mknod -m 666 /dev/null    c 1 3
[ -c /dev/tty ]     || mknod -m 666 /dev/tty     c 5 0
[ -c /dev/console ] || mknod -m 600 /dev/console c 5 1

# Mount persistent data partition for config DB
mkdir -p /etc/stargazer
_sg_dev=""

# BusyBox blkid does not support -s/-o flags (util-linux only).
# Parse raw blkid output: /dev/x: LABEL="val" TYPE="val" ...
_blkid_val() { # $1=FIELD $2=/dev/device
	blkid "$2" 2>/dev/null | sed -n 's/.*'"$1"'="\([^"]*\)".*/\1/p'
}

# Writes to /dev/kmsg (persists in dmesg) and to stdout.
_sg_log() { # $1=level $2=message
	_lvl="$1"
	shift
	_msg="$*"
	if [ -w /dev/kmsg ]; then
		echo "<${_lvl}>stargazer: ${_msg}" > /dev/kmsg 2>/dev/null
	fi
	echo "[stargazer] ${_msg}"
}

_sg_info() { _sg_log 6 "$@"; }
_sg_warn() { _sg_log 4 "$@"; }
_sg_err()  { _sg_log 3 "$@"; }

# --- Persistent storage detection (eMMC-primary boot) ---
#
# Strategy: use known partition for sgdata (mmcblk0p5 or QEMU vdb).
# No scanning — only hardcoded devices, never USB/removable media.
# If partition exists but is blank or has wrong type, reformat it.
# Run e2fsck before mount if available (ext2 has no journal).

# Helper: create ext2 filesystem with no fsck-required flag.
# BusyBox mke2fs sets s_max_mnt_count and s_checkinterval to non-zero
# defaults, which causes the kernel to warn "mounting unchecked fs".
# After formatting, patch the superblock to disable these checks:
#   s_max_mnt_count (offset 0x434, 2 bytes LE) = 0
#   s_checkinterval (offset 0x448, 4 bytes LE) = 0
_sg_mkfs() { # $1=label $2=/dev/device
	mke2fs -L "$1" "$2" 2>/dev/null || return 1
	printf '\x00\x00' | dd of="$2" bs=1 seek=1076 count=2 conv=notrunc 2>/dev/null
	printf '\x00\x00\x00\x00' | dd of="$2" bs=1 seek=1096 count=4 conv=notrunc 2>/dev/null
}

# Helper: validate and prepare a partition for use.
# $1=label (e.g. "sgdata" or "sglogs"), $2=/dev/device
# Returns 0 on success, non-zero on failure.
_sg_prepare() {
	_label="$1"
	_dev="$2"
	_type=$(_blkid_val TYPE "$_dev")
	_lbl=$(_blkid_val LABEL "$_dev")

	if [ "$_lbl" = "$_label" ] && [ "$_type" = "ext2" ]; then
		return 0
	fi

	if [ -z "$_type" ]; then
		# Blank partition (first boot or wiped) — format
		_sg_info "First boot: formatting $_dev as $_label..."
		_sg_mkfs "$_label" "$_dev"
		return $?
	fi

	if [ "$_type" != "ext2" ]; then
		# Wrong filesystem type (e.g. old OpenWrt squashfs/ext4)
		_sg_warn "$_dev has type '$_type', expected ext2"
		_sg_warn "Reformatting $_dev as $_label (old data will be lost)..."
		_sg_mkfs "$_label" "$_dev"
		return $?
	fi

	# ext2 but wrong/missing label — reformat (no tune2fs in busybox)
	if [ "$_lbl" != "$_label" ]; then
		_sg_warn "$_dev is ext2 but labeled '$_lbl', expected $_label"
		_sg_warn "Reformatting $_dev as $_label..."
		_sg_mkfs "$_label" "$_dev"
		return $?
	fi
}

# Helper: run e2fsck if available, reformat if unfixable.
_sg_fsck() { # $1=/dev/device $2=label (for reformat)
	if ! command -v e2fsck >/dev/null 2>&1; then
		return 0  # e2fsck not available, skip check
	fi
	_sg_info "Checking filesystem on $1..."
	e2fsck -p "$1" 2>/dev/null
	_rc=$?
	if [ "$_rc" -ge 4 ]; then
		# Exit code >= 4 means uncorrectable errors
		_fsck_lbl="${2:-sgdata}"
		_sg_err "filesystem on $1 has uncorrectable errors (rc=$_rc)"
		_sg_warn "Reformatting $1 as $_fsck_lbl..."
		_sg_mkfs "$_fsck_lbl" "$1"
	fi
}

# --- sgdata detection ---
# GPT layout: p1=env, p2=factory, p3=fip, p4=firmware, p5=sgdata, p6=sglogs
# Hardcoded to known devices only — never scan USB/removable media.
_init_errors=""
_sg_dev=""

# Wait up to 30 seconds for storage device to appear (kernel async probing)
_wait_count=0
while [ $_wait_count -lt 300 ]; do
	if [ -b /dev/mmcblk0p5 ]; then
		_sg_dev=/dev/mmcblk0p5
		break
	elif [ -b /dev/vdb ]; then
		_sg_dev=/dev/vdb   # QEMU: vda=boot, vdb=sgdata, vdc=sglogs
		break
	fi
	_wait_count=$((_wait_count + 1))
	sleep 0.1 2>/dev/null || usleep 100000 2>/dev/null || true
done

if [ -z "$_sg_dev" ]; then
	_sg_err "sgdata target not found (no mmcblk0p5, no vdb) after 30s wait"
	_sg_err "--- MMC diagnostic ---"
	ls /dev/mmcblk* 2>/dev/null && true || _sg_err "  no /dev/mmcblk* devices found"
	dmesg 2>/dev/null | grep -iE 'mmc|mtk.*mmc|msdc|blkrrpart|block|gpt|efi.part' | tail -30
	_sg_err "--- end diagnostic ---"
	_init_errors="${_init_errors}storage "
else
	_sg_info "Found sgdata device: $_sg_dev"
fi

# Prepare, fsck, and mount sgdata
if [ -n "$_sg_dev" ]; then
	if ! _sg_prepare sgdata "$_sg_dev"; then
		_sg_err "failed to prepare $_sg_dev as sgdata"
		_init_errors="${_init_errors}storage "
		_sg_dev=""
	fi
fi

if [ -n "$_sg_dev" ] && ! mountpoint -q /etc/stargazer 2>/dev/null; then
	_sg_info "Found data partition: $_sg_dev"
	_sg_fsck "$_sg_dev" sgdata
	if mount -o rw "$_sg_dev" /etc/stargazer 2>/tmp/sg_mount.log; then
		_sg_info "Persistent storage: $_sg_dev -> /etc/stargazer"
	else
		_sg_err "mount $_sg_dev failed:"
		cat /tmp/sg_mount.log 2>/dev/null
		# Last resort: reformat and retry
		_sg_warn "Attempting reformat of $_sg_dev..."
		_sg_mkfs sgdata "$_sg_dev"
		if mount -o rw "$_sg_dev" /etc/stargazer 2>/dev/null; then
			_sg_info "Persistent storage recovered: $_sg_dev -> /etc/stargazer"
		else
			_sg_err "CRITICAL: $_sg_dev unusable after reformat"
			_init_errors="${_init_errors}storage "
			_sg_dev=""
		fi
	fi
fi

# Restore saved auth files from persistent storage
if mountpoint -q /etc/stargazer 2>/dev/null; then
	if [ -f /etc/stargazer/shadow ]; then
		cp /etc/stargazer/shadow /etc/shadow
		chmod 640 /etc/shadow
		_sg_info "Restored /etc/shadow from persistent storage"
	fi
	if [ -f /etc/stargazer/passwd ]; then
		cp /etc/stargazer/passwd /etc/passwd
		_sg_info "Restored /etc/passwd from persistent storage"
	fi
	if [ -f /etc/stargazer/group ]; then
		cp /etc/stargazer/group /etc/group
		_sg_info "Restored /etc/group from persistent storage"
	fi
fi

# --- sglogs detection ---
# Derive sglogs device from sgdata device (no scan).
if [ -n "$_sg_dev" ]; then
	_logs_dev=""
	case "$_sg_dev" in
		/dev/mmcblk0p5) _logs_dev=/dev/mmcblk0p6 ;;
		/dev/vdb)       _logs_dev=/dev/vdc ;;  # QEMU: vda=boot, vdb=sgdata, vdc=sglogs
	esac

	if [ -z "$_logs_dev" ]; then
		_sg_warn "cannot determine sglogs device for $_sg_dev"
		_init_errors="${_init_errors}logs "
	elif [ ! -b "$_logs_dev" ]; then
		# eMMC: partition may not exist yet — create it
		case "$_logs_dev" in
			/dev/mmcblk0p6)
				_sg_info "sglogs partition missing, running sg-partinit..."
				if command -v sg-partinit >/dev/null 2>&1 && \
				   sg-partinit /dev/mmcblk0 2>/tmp/sg_partinit.log; then
					# sg-partinit waits for the device node
					# to appear before returning (verified via
					# stat loop after BLKRRPART ioctl).
					if [ ! -b "$_logs_dev" ]; then
						_sg_err "$_logs_dev still missing after sg-partinit"
						_init_errors="${_init_errors}logs "
						_logs_dev=""
					fi
				else
					_sg_err "sg-partinit failed:"
					cat /tmp/sg_partinit.log 2>/dev/null
					_init_errors="${_init_errors}logs "
					_logs_dev=""
				fi
				;;
			*)
				_sg_warn "$_logs_dev not present (QEMU without logs drive?)"
				_init_errors="${_init_errors}logs "
				_logs_dev=""
				;;
		esac
	fi

	# Prepare, fsck, and mount sglogs
	if [ -n "$_logs_dev" ]; then
		if ! _sg_prepare sglogs "$_logs_dev"; then
			_sg_err "failed to prepare $_logs_dev as sglogs"
			_init_errors="${_init_errors}logs "
			_logs_dev=""
		fi
	fi

	if [ -n "$_logs_dev" ]; then
		mkdir -p /etc/stargazer/logs
		_sg_fsck "$_logs_dev" sglogs
		if mount -o rw "$_logs_dev" /etc/stargazer/logs 2>/dev/null; then
			_sg_info "Logs storage: $_logs_dev -> /etc/stargazer/logs"
		else
			_sg_warn "mount $_logs_dev failed, reformatting..."
			_sg_mkfs sglogs "$_logs_dev"
			if mount -o rw "$_logs_dev" /etc/stargazer/logs 2>/dev/null; then
				_sg_info "Logs storage recovered: $_logs_dev -> /etc/stargazer/logs"
			else
				_sg_err "$_logs_dev unusable after reformat"
				_init_errors="${_init_errors}logs "
			fi
		fi
	fi
fi

# Report storage/logs failures
if [ -z "$_sg_dev" ]; then
	_sg_warn "no partition for config storage — config will not survive reboot"
fi

# Ensure /dev/tty is accessible by non-root users (for readline terminal I/O)
[ -c /dev/tty ] && chmod 0666 /dev/tty 2>/dev/null
echo 1 > /proc/sys/kernel/sysrq
# tty_open() for major 5,1 sets O_NONBLOCK internally, so this never blocks
# on carrier — unlike opening /dev/ttyS0 (major 4,64) directly.
exec 0</dev/console 1>/dev/console 2>&1

# Suppress kernel console messages (prevents raw terminal corruption)
echo 1 > /proc/sys/kernel/printk

# Banner
clear 2>/dev/null
_l1="STARGAZER NGFW v@VERSION@"
_l2="Gazing at the stellar ~~~"
printf "\n"
printf "  ╔═══════════════════════════════════════════════════════════╗\n"
printf "  ║  %-55s  ║\n" "$_l1"
printf "  ║  %-55s  ║\n" "$_l2"
printf "  ╚═══════════════════════════════════════════════════════════╝\n"
printf "\n"
echo "Kernel: $(uname -r) | Arch: $(uname -m)"

# Write firmware version for runtime queries (substituted at build time)
echo "@VERSION@" > /tmp/stargazer-fw-version

# Ensure stargazer system group exists (used for socket + config file ACL)
if ! grep -q '^stargazer:' /etc/group 2>/dev/null; then
	_sg_gid=900
	while grep -q "^[^:]*:[^:]*:${_sg_gid}:" /etc/group 2>/dev/null; do
		_sg_gid=$((_sg_gid + 1))
	done
	echo "stargazer:x:${_sg_gid}:" >> /etc/group
fi

# Ensure __webd service account exists (webd drops to this UID for SO_PEERCRED)
if ! grep -q '^__webd:' /etc/passwd 2>/dev/null; then
	echo '__webd:x:900:900:webd service:/:/bin/false' >> /etc/passwd
fi

# Lock down INPUT before any interface comes up — prevents a window
# where traffic is accepted before mgmtd sets firewall rules.
# mgmtd_init_firewall() will re-set this and add proper rules later.
iptables -P INPUT DROP 2>/dev/null
iptables -P FORWARD DROP 2>/dev/null
# Also set IPv6 FORWARD to DROP if ip6tables is available
ip6tables -P FORWARD DROP 2>/dev/null

[ -x /etc/init.d/stargazer ] && /etc/init.d/stargazer start

# DHCP is managed by mgmtd — interfaces with mode=dhcp get udhcpc
# started during mgmtd_replay_config() on boot.

# Start management daemon (privilege separation)
# mgmtd now supervises webd, udhcpc, udhcpd — wrapping in a restart
# loop so init can recover from mgmtd crashes without a full reboot.
if [ -x /sbin/stargazer-mgmtd ]; then
	echo "[stargazer] Starting management daemon..."
	_ready=/run/mgmtd-ready
	mkfifo "$_ready" 2>/dev/null
	(while true; do
		/sbin/stargazer-mgmtd
		[ -f /tmp/stargazer-shutdown ] && break
		sleep 2
	done) &
	# Block until mgmtd signals readiness via FIFO (zero-CPU wait).
	# Config replay applies iptables/ip rules for every interface —
	# can take 10-20s on large configs.  30s timeout covers worst case.
	(sleep 30; echo timeout > "$_ready" 2>/dev/null) &
	_to=$!
	read _sig < "$_ready"
	kill "$_to" 2>/dev/null; wait "$_to" 2>/dev/null
	rm -f "$_ready"
	case "$_sig" in
		ready) echo "[stargazer] Management daemon ready." ;;
		error)
			echo ""
			echo "  CRITICAL: Boot integrity check FAILED"
			echo "  Database may be corrupted or tampered with."
			echo "  Management daemon refused to start."
			echo ""
			_init_errors="${_init_errors}mgmtd "
			;;
		*) echo "[stargazer] WARNING: Management daemon did not start (timeout)."
			_init_errors="${_init_errors}mgmtd "
			;;
	esac
fi
# webd is now started by mgmtd's supervisor — no init block needed.

# Create commands (remove busybox symlinks first to avoid "Text file busy")
rm -f /sbin/service /sbin/poweroff /sbin/reboot /sbin/halt /sbin/shutdown

cat > /sbin/service << 'SVC'
#!/bin/sh
[ -x "/etc/init.d/$1" ] && "/etc/init.d/$1" "$2" || echo "Usage: service <name> <action>"
SVC

# Shared shutdown helper — exec'd by /sbin/poweroff and /sbin/reboot.
# Argument: "halt" or "reboot".
cat > /usr/libexec/stargazer/shutdown.sh << 'SHUTDOWN'
#!/bin/sh
_action="${1:-halt}"

# Ignore SIGTERM so the broadkill in phase 2 cannot kill this script.
# kill(-1, sig) excludes the calling process on Linux, but if kill is
# an external command (not a shell builtin), the forked child calls
# kill() and the PARENT (this script) would receive the signal.
trap '' TERM

# Reopen stdout/stderr to console (safe_exec redirects them to a pipe)
exec >/dev/console 2>&1 </dev/console
# Reset terminal from raw mode (CLI readline leaves it raw)
stty sane 2>/dev/null
# Suppress kernel console during shutdown (only KERN_EMERG)
echo 1 > /proc/sys/kernel/printk 2>/dev/null
# Signal init to not restart login
touch /tmp/stargazer-shutdown

echo ""
if [ "$_action" = "reboot" ]; then
	echo "[stargazer] Rebooting..."
else
	echo "[stargazer] Shutting down..."
fi

# ── Phase 1: Graceful stop (SIGTERM) ────────────────────────────────────

# Kill entire login process group at once — login shell + CLI die
# simultaneously, so no parent shell survives to print "Terminated".
# setsid -c makes the login shell PID = PGID.
echo "[stargazer] Stopping login session..."
if [ -f /tmp/stargazer-login.pid ]; then
	_lpid=$(cat /tmp/stargazer-login.pid 2>/dev/null)
	[ -n "$_lpid" ] && kill -- -"$_lpid" 2>/dev/null
fi
sleep 0.3
# Safety net: kill any stragglers individually
killall stargazer-cli 2>/dev/null
killall stargazer-logind 2>/dev/null

# SIGTERM mgmtd — its shutdown_children() handles webd, udhcpc, udhcpd
# (SIGUSR2 for DHCP RELEASE, SIGTERM, then SIGKILL for stragglers).
echo "[stargazer] Stopping management daemon (+ supervised services)..."
killall stargazer-mgmtd 2>/dev/null
sleep 1

echo "[stargazer] Stopping init services..."
for s in /etc/init.d/*; do [ -x "$s" ] && "$s" stop 2>/dev/null; done

# ── Phase 2: Kill remaining processes ───────────────────────────────────

# SIGTERM everything except PID 1 (this script runs as a child of mgmtd,
# which is already SIGTERM'd above — safe to broadkill here).
echo "[stargazer] Killing remaining processes..."
kill -TERM -1 2>/dev/null
sleep 1
# Force-kill anything that ignored SIGTERM (stuck I/O, hung daemons).
# Without this, open files can prevent umount.
kill -KILL -1 2>/dev/null
sleep 0.5

# ── Phase 3: Save persistent state ─────────────────────────────────────

echo "[stargazer] Saving auth files..."
if mountpoint -q /etc/stargazer 2>/dev/null; then
	cp /etc/shadow /etc/stargazer/shadow 2>/dev/null
	cp /etc/passwd /etc/stargazer/passwd 2>/dev/null
	cp /etc/group /etc/stargazer/group 2>/dev/null
fi

# ── Phase 4: Unmount with fallback ──────────────────────────────────────

# Try clean umount → lazy umount → remount read-only.
# ext2 has no journal — dirty unmount risks filesystem corruption.
_sg_umount() {
	_mp="$1"
	mountpoint -q "$_mp" 2>/dev/null || return 0
	if umount "$_mp" 2>/dev/null; then
		return 0
	fi
	echo "[stargazer] WARNING: umount $_mp failed, trying lazy unmount..."
	if umount -l "$_mp" 2>/dev/null; then
		return 0
	fi
	echo "[stargazer] WARNING: lazy umount $_mp failed, remounting read-only..."
	mount -o remount,ro "$_mp" 2>/dev/null
}

echo "[stargazer] Unmounting logs partition..."
_sg_umount /etc/stargazer/logs

echo "[stargazer] Unmounting data partition..."
_sg_umount /etc/stargazer

echo "[stargazer] Syncing disks..."
sync

# ── Phase 5: Final action ──────────────────────────────────────────────

if [ "$_action" = "reboot" ]; then
	echo "[stargazer] System rebooting now..."
	sleep 1
	/bin/busybox reboot -f
else
	# MT7988A ATF lacks PSCI SYSTEM_OFF — 'poweroff' triggers an
	# unsupported error. 'halt -f' stops the CPU without PSCI.
	echo "[stargazer] System halted. You may remove power."
	/bin/busybox halt -f
fi
SHUTDOWN

cat > /sbin/poweroff << 'PWR'
#!/bin/sh
exec /bin/sh /usr/libexec/stargazer/shutdown.sh halt
PWR

cat > /sbin/reboot << 'RBT'
#!/bin/sh
exec /bin/sh /usr/libexec/stargazer/shutdown.sh reboot
RBT

chmod +x /sbin/service /sbin/poweroff /sbin/reboot /usr/libexec/stargazer/shutdown.sh
cp /sbin/poweroff /sbin/halt
cp /sbin/poweroff /sbin/shutdown

# Keep kernel console quiet — only KERN_WARNING and above.
# INFO/NOTICE messages (USB enumeration, driver probes) would otherwise
# print over the login prompt. Full kernel log is available via 'dmesg'.
dmesg -n 4 2>/dev/null

# Login loop
# -c: set stdin as controlling terminal so Ctrl+C generates SIGINT
if [ -z "$_init_errors" ]; then
	_sg_info "Ready."
else
	_sg_err "init completed with failures: ${_init_errors}"
	_sg_warn "Some features may not work correctly."
fi
while true; do
	setsid -c /sbin/stargazer-login </dev/console >/dev/console 2>&1
	# If shutdown/reboot is in progress, stop restarting login
	[ -f /tmp/stargazer-shutdown ] && break
	sleep 2
done
# Keep init (PID 1) alive — kernel panics if PID 1 exits
while true; do sleep 3600; done

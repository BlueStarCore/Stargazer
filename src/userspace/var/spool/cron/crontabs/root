# Stargazer IPS signature auto-update — runs daily at 12:00.
# Wrapper self-checks the security_ips auto-update mode (disable/daily/weekly) from .update.conf.
0 12 * * * /usr/libexec/stargazer/ips-update-cron.sh >/dev/null 2>&1

# Rotate ips-alert.log by size (default 5 MB, keep 5 copies) — checked hourly.
# Rename the file then SIGHUP ipsd so it reopens the fd (busybox has no logrotate).
0 * * * * /usr/libexec/stargazer/ips-log-rotate.sh >/dev/null 2>&1

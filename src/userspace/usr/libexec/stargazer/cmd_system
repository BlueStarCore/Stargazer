#!/bin/sh
# Stargazer NGFW - System Command
# Privileged operations routed through mgmtd via IPC.

CMD_DIR="${CMD_DIR:-/usr/libexec/stargazer}"
. "$CMD_DIR/config_lib.sh"

subcmd="$1"
shift 2>/dev/null

# Helper: check if user has a permission
has_permission() {
	echo ",$STARGAZER_PERMISSIONS," | grep -q ",$1,"
}

# Requires admin permission
require_power() {
	if ! has_permission "admin"; then
		echo "  Permission denied: requires 'admin'"
		return 1
	fi
	return 0
}

case "$subcmd" in
	help)
		echo "  === Stargazer NGFW — Command Reference ==="
		echo ""
		echo "  help                  Show this help"
		echo "  exit / logout         Logout from CLI"
		if has_permission "admin"; then
			echo "  poweroff / shutdown   Shut down the system"
			echo "  reboot                Reboot the system"
		fi
		if has_permission "monitor"; then
			echo ""
			echo "  --- Show Commands ---"
			echo "  show status           Module and system status"
			echo "  show sessions         Active session table"
			echo "  show stats            Packet statistics"
			echo "  show interfaces       Network interfaces"
			echo "  show routes           Routing table"
		echo "  show configure        Running configuration"
		echo "  show config           Modules and sysctl config"
		fi
		if has_permission "configure"; then
			echo ""
			echo "  --- Configure Commands ---"
			echo "  configure commit [message]        Save configuration revision"
			echo "  configure revisions               List configuration revisions"
			echo "  configure rollback <rev>          Roll back to a revision"
			echo "  configure network route static    Static routes"
			echo "  configure network route policy    Policy-based routing"
			echo "  configure network ospf            OSPF dynamic routing"
			echo "  configure network nat             NAT rules (SNAT/DNAT)"
			echo "  configure network dns             DNS settings"
			echo "  configure system settings         System general settings"
			echo "  configure system interface        Network interfaces"
			echo "  configure system hostname         System hostname"
			echo "  configure firewall policy         Firewall policies"
			echo "  configure firewall address        Address objects"
			echo "  configure firewall service        Service objects"
		fi
		if has_permission "admin"; then
			echo ""
			echo "  --- Admin Commands ---"
			echo "  configure system admin-profile   Manage admin profiles"
			echo "  configure system admin profile   (alias)"
			echo "  configure system admin           Manage admin accounts"
			echo "  configure system password-policy  Manage password policy"
			echo "  execute debug enable|disable     Toggle debug output"
			echo "  execute debug flow trace ...     Packet flow trace"
			echo "  execute debug cli ...            CLI input/action trace"
			echo "  execute debug mgmtd ...          mgmtd daemon trace"
			echo "  execute debug auth ...           Authentication trace"
			echo "  execute debug top                Process snapshot"
			echo "  execute debug resources ...      CPU/RAM/Disk/Interface usage"
			echo "  execute debug reset              Reset debug runtime state"
		fi
		echo ""
		echo "  Press Tab for completion, ? for context help."
		echo ""
		;;
	poweroff)
		require_power || exit 1
		echo "  Shutting down..."
		if _ipc_available; then
			ipc_send 600
			[ "$IPC_RC" -ne 0 ] && ipc_print_error && exit 1
		else
			/sbin/poweroff
		fi
		;;
	shutdown)
		require_power || exit 1
		echo "  Shutting down..."
		if _ipc_available; then
			ipc_send 600
			[ "$IPC_RC" -ne 0 ] && ipc_print_error && exit 1
		else
			/sbin/poweroff
		fi
		;;
	reboot)
		require_power || exit 1
		echo "  Rebooting..."
		if _ipc_available; then
			ipc_send 601
			[ "$IPC_RC" -ne 0 ] && ipc_print_error && exit 1
		else
			/sbin/reboot
		fi
		;;
	*)
		echo "  Usage: system <help|poweroff|shutdown|reboot>"
		;;
esac

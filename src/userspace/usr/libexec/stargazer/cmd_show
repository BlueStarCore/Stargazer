#!/bin/sh
# Stargazer NGFW - Show Command
# Requires: monitor permission

CMD_DIR="${CMD_DIR:-/usr/libexec/stargazer}"
. "$CMD_DIR/config_lib.sh"

# Dump a table type from a domain file in FortiGate format
_dump_table() {
	_dt_type="$1"
	_dt_file="$2"
	_dt_label="$(_key_to_label "$_dt_type")"

	_ids=$(cfg_list "$_dt_file" "$_dt_type")
	[ -z "$_ids" ] && return

	echo "config $_dt_label"
	for _id in $_ids; do
		echo "  edit $_id"
		cfg_get "$_dt_file" "${_dt_type}:${_id}" | while IFS='=' read -r _k _v; do
			[ -z "$_k" ] && continue
			# Hide passwords and builtin markers
			case "$_k" in
				password) _v="********" ;;
				builtin)  continue ;;
			esac
			echo "    set $_k $_v"
		done
		echo "  next"
	done
	echo "end"
	echo ""
}

# Dump a single type from a domain file in FortiGate format
_dump_single() {
	_ds_type="$1"
	_ds_file="$2"
	_ds_label="$(_key_to_label "$_ds_type")"

	_data=$(cfg_get "$_ds_file" "$_ds_type" 2>/dev/null)
	[ -z "$_data" ] && return

	echo "config $_ds_label"
	echo "$_data" | while IFS='=' read -r _k _v; do
		[ -z "$_k" ] && continue
		case "$_k" in
			builtin) continue ;;
		esac
		echo "  set $_k $_v"
	done
	echo "end"
	echo ""
}

# Show all configuration from all domain files in FortiGate style
_show_all_config_db() {
	_db_ready || return 1
	_rows=$(sqlite3 -separator '|' "$STARGAZER_DB_PATH" "SELECT type, object_id, data FROM config_objects ORDER BY type, object_id;" 2>/dev/null)
	[ -z "$_rows" ] && return 1
	_cur_type=""
	_cur_mode=""
	echo "$_rows" | while IFS='|' read -r _t _id _blob; do
		[ -z "$_t" ] && continue
		if [ "$_cur_type" != "$_t" ]; then
			[ -n "$_cur_type" ] && echo "end" && echo ""
			_cur_type="$_t"
			_cur_mode=$(cfg_type_mode "$_t")
			echo "config $(_key_to_label "$_t")"
		fi
		_dec=$(printf '%s' "$_blob" | sed 's/\\n/\
/g')
		case "$_cur_mode" in
			table)
				echo "  edit $_id"
				echo "$_dec" | while IFS='=' read -r _k _v; do
					[ -z "$_k" ] && continue
					case "$_k" in
						password) _v="********" ;;
						builtin) continue ;;
					esac
					echo "    set $_k $_v"
				done
				echo "  next"
				;;
			single)
				echo "$_dec" | while IFS='=' read -r _k _v; do
					[ -z "$_k" ] && continue
					case "$_k" in builtin) continue ;; esac
					echo "  set $_k $_v"
				done
				;;
		esac
	done
	[ -n "$_cur_type" ] && echo "end" && echo ""
	return 0
}

_show_all_config() {
	_show_all_config_db && return

	# Use IPC-backed cfg_list/cfg_get instead of direct file reads.
	# Iterate known CONFIG_TYPES (defined in config_lib.sh) to avoid
	# cfg_list_types which requires direct file access.
	_sac_IFS="$IFS"
	IFS='
'
	for _ct_line in $CONFIG_TYPES; do
		[ -z "$_ct_line" ] && continue
		_ct_key="${_ct_line%%:*}"
		_ct_mode="${_ct_line##*:}"
		_ct_file=$(cfg_domain_for "$_ct_key")
		case "$_ct_mode" in
			table)  _dump_table "$_ct_key" "$_ct_file" ;;
			single) _dump_single "$_ct_key" "$_ct_file" ;;
		esac
	done
	IFS="$_sac_IFS"
}

subcmd="$1"
shift 2>/dev/null

case "$subcmd" in
	status)
		if _ipc_available; then
			ipc_send 610
			if [ "$IPC_RC" -eq 0 ]; then
				echo "$IPC_PAYLOAD"
			else
				echo "  === Stargazer Status ==="
				# Fallback to local check
				if lsmod 2>/dev/null | grep -q pkt_forward; then
					echo "  Module pkt_forward: loaded"
				else
					echo "  Module pkt_forward: not loaded"
				fi
				echo "  Uptime: $(cut -d' ' -f1 /proc/uptime 2>/dev/null)s"
			fi
		else
			if lsmod 2>/dev/null | grep -q pkt_forward; then
				echo "  Module pkt_forward: loaded"
			else
				echo "  Module pkt_forward: not loaded"
			fi
			if lsmod 2>/dev/null | grep -q session; then
				echo "  Module session:     loaded"
			else
				echo "  Module session:     not loaded"
			fi
			echo "  Uptime: $(cut -d' ' -f1 /proc/uptime 2>/dev/null)s"
		fi
		;;
	sessions)
		if [ -f /proc/stargazer/sessions ]; then
			echo "  === Active Sessions ==="
			cat /proc/stargazer/sessions
		else
			echo "  Session tracking not available (module not loaded)"
		fi
		;;
	stats)
		echo "  === Packet Statistics ==="
		dmesg 2>/dev/null | grep -i 'pkt_forward\|forwarded\|dropped' | tail -10
		;;
	interfaces)
		if _ipc_available; then
			ipc_send 611
			if [ "$IPC_RC" -eq 0 ]; then
				echo "  === Network Interfaces ==="
				echo "$IPC_PAYLOAD"
			else
				echo "  === Network Interfaces ==="
				ip -brief link 2>/dev/null || ifconfig -a 2>/dev/null
			fi
		else
			echo "  === Network Interfaces ==="
			ip -brief link 2>/dev/null || ifconfig -a 2>/dev/null
		fi
		;;
	routes)
		if _ipc_available; then
			ipc_send 612
			if [ "$IPC_RC" -eq 0 ]; then
				echo "  === Routing Table ==="
				echo "$IPC_PAYLOAD"
			else
				echo "  === Routing Table ==="
				ip route 2>/dev/null || route -n 2>/dev/null
			fi
		else
			echo "  === Routing Table ==="
			ip route 2>/dev/null || route -n 2>/dev/null
		fi
		;;
	configure)
		echo "  === Running Configuration ==="
		echo ""
		_show_all_config
		;;
	config)
		echo "  === Stargazer Configuration ==="
		echo "  Modules:"
		if [ -f /etc/modules-load.d/stargazer.conf ]; then
			sed 's/^/    /' /etc/modules-load.d/stargazer.conf
		fi
		echo "  Sysctl:"
		if [ -f /etc/sysctl.d/10-stargazer.conf ]; then
			grep -v '^#' /etc/sysctl.d/10-stargazer.conf \
				| grep -v '^$' | sed 's/^/    /'
		fi
		;;
	"")
		echo "  Usage: show <subcommand>"
		echo "  Subcommands: status sessions stats interfaces routes configure config"
		;;
	*)
		echo "  Unknown subcommand: $subcmd"
		echo "  Subcommands: status sessions stats interfaces routes configure config"
		;;
esac
